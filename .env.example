# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit .env — file .env đã nằm trong .gitignore.

# ===== DJANGO =====
# Tạo key mới: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ===== DATABASE (MySQL 8) =====
DB_NAME=uni_map
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ===== OAUTH (để trống nếu chỉ dùng đăng nhập thường) =====
# Google Cloud Console -> Credentials -> OAuth client ID
# Redirect URI: <host>/accounts/google/xac-thuc/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook for Developers -> OAuth client
# Valid OAuth Redirect URIs: <host>/accounts/facebook/xac-thuc/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
