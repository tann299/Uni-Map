# Cấu hình môi trường Uni Map (Copy thành .env và điền giá trị thật)

# ===== DJANGO =====
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ===== CSDL MYSQL =====
DB_NAME=uni_map
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ===== OAUTH 2.0 GOOGLE =====
# Google Cloud Console -> Credentials -> OAuth client ID (Web application)
# Redirect URI: http://localhost:8000/accounts/google/xac-thuc/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== OAUTH 2.0 FACEBOOK =====
# Facebook Developers -> App settings -> Basic + Facebook Login
# Redirect URI: http://localhost:8000/accounts/facebook/xac-thuc/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
